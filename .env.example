# Üyelik sistemi için gerekli ortam değişkenleri.
# Üretimde (Coolify → Environment Variables) bunları ayarlayın.
# Gerçek değerleri .env.local'a yazın (repoya girmez).

# JWT imzalama anahtarı — uzun, rastgele, GİZLİ. Örn:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=

# İlk açılışta oluşturulacak süper admin hesabı.
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=

# SQLite veritabanı yolu. Üretimde KALICI volume'a denk gelmeli,
# yoksa her redeploy'da üyelikler/geçmiş silinir.
# Coolify'da örn. volume mount: /app/data  →  DATABASE_PATH=/app/data/lightsim.db
DATABASE_PATH=./data/lightsim.db
